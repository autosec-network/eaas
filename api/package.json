	],
	"license": "AGPL-3.0-only",
	"private": true,
	"bugs": {
		"url": "https://github.com/autosec-network/eaas/issues"
	},
	"homepage": "https://github.com/autosec-network/eaas/tree/production/api#readme",
	"dependencies": {
		"@hono/node-server": "^1.14.1",
		"@hono/zod-openapi": "^0.19.5",
		"@hono/zod-validator": "^0.4.2",
		"@mjackson/multipart-parser": "^0.8.2",
		"@noble/post-quantum": "^0.4.0",
		"@scalar/hono-api-reference": "^0.8.5",
		"cron-schedule": "^5.0.4",
		"cron-validate": "^1.4.5",
		"hono": "^4.7.7",
		"validator": "^13.12.0",
		"zod": "^3.24.3"
	},
	"devDependencies": {
		"@types/validator": "^13.12.2",
		"wrangler": "https://prerelease-registry.devprod.cloudflare.dev/workers-sdk/runs/14180338760/npm-package-wrangler-8740"
	}
