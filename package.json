{
	"type": "module",
	"scripts": {
		"fmt": "prettier --check .",
		"fmt:fix": "prettier --write .",
		"lint": "eslint **/*.*ts*",
		"lint:fix": "npm run lint -- --fix",
		"preclean": "npx -y rimraf@latest --glob ./**/.wrangler ./**/*.tsbuildinfo",
		"clean": "npm -w frontend -w api run clean",
		"cli:pre": "tsx shared/db-preview/cli.mts",
		"dev": "tsx --env-file-if-exists=devScripts/.dev.vars devScripts/cli.mts",
		"generate:pre:root": "npm exec -- drizzle-kit generate --dialect=sqlite --driver d1-http --casing=snake_case --schema=\"shared/db-preview/schemas/root/index.ts\" --out=\"shared/db-preview/schemas/root\"",
		"generate:pre:tenant": "npm exec -- drizzle-kit generate --dialect=sqlite --driver d1-http --casing=snake_case --schema=\"shared/db-preview/schemas/tenant/index.ts\" --out=\"shared/db-preview/schemas/tenant\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/autosec-network/eaas.git"
	},
	"author": "Autosec",
	"contributors": [
		"DemosJarco <1209494+demosjarco@users.noreply.github.com>",
		"George Portillo <georgeportillodesign@gmail.com>"
	],
	"license": "AGPL-3.0-only",
	"private": true,
	"bugs": {
		"url": "https://github.com/autosec-network/eaas/issues"
	},
	"homepage": "https://github.com/autosec-network/eaas?tab=readme-ov-file",
	"workspaces": [
		"frontend",
		"sidecar",
		"api"
	],
	"dependencies": {
		"cloudflare": "^4.3.0",
		"drizzle-orm": "^0.44.2",
		"jose": "^6.0.11",
		"uuid": "^11.0.3"
	},
	"devDependencies": {
		"@auth/core": "^0.39.1",
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.29.5",
		"@cloudflare/workers-types": "^4.20250628.0",
		"@demosjarco/prettier-config": "^1.0.1",
		"@eslint/js": "^9.30.1",
		"@iarna/toml": "^2.2.5",
		"@types/iarna__toml": "^2.0.5",
		"@types/node": "^22.15.34",
		"@types/yargs": "^17.0.33",
		"chalk": "^5.5.0",
		"drizzle-kit": "^0.31.4",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^10.1.5",
		"lerna": "^8.2.3",
		"p-queue": "^8.0.1",
		"prettier": "^3.6.2",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.36.0",
		"wrangler": "^4.24.0",
		"yargs": "^18.0.0"
	}
}
