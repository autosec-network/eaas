{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"dependsOn": ["Qwik Types", "PQC Container Types"],
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Lint",
			"type": "npm",
			"script": "lint:fix",
			"problemMatcher": "$eslint-stylish",
			"icon": {
				"id": "lightbulb-autofix",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "Qwik Types",
			"type": "typescript",
			"tsconfig": "frontend/tsconfig.json",
			"option": "watch",
			"problemMatcher": ["$tsc-watch"],
			"isBackground": true,
			"icon": {
				"id": "symbol-type-parameter",
				"color": "terminal.ansiBlue"
			}
		},
		{
			"label": "PQC Container Types",
			"type": "typescript",
			"tsconfig": "api/pqc/container/tsconfig.json",
			"option": "watch",
			"problemMatcher": ["$tsc-watch"],
			"isBackground": true,
			"icon": {
				"id": "symbol-type-parameter",
				"color": "terminal.ansiBlue"
			}
		}
	]
}
