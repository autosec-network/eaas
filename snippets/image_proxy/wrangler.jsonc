{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "image_proxy",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-14",
	"workers_dev": false,
	"preview_urls": false,
	"minify": true,
	"keep_names": false,
	"upload_source_maps": false,
	"limits": { "cpu_ms": 5, "subrequests": 5 }
}
