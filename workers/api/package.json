	"private": true,
	"bugs": {
		"url": "https://github.com/autosec-network/eaas/issues"
	},
	"homepage": "https://github.com/autosec-network/eaas/blob/production/workers/api/README.md",
	"dependencies": {
		"@hono/zod-openapi": "1.6.3",
		"@hono/zod-validator": "0.9.1",
		"@noble/post-quantum": "0.7.1",
		"cron-schedule": "6.0.0",
		"cron-validate": "1.5.3",
		"db": "*",
		"drizzle-orm": "1.0.0-rc.4",
		"helpers": "*",
		"hono": "4.13.7",
		"jose": "6.2.12",
