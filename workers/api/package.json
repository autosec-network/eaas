{
	"name": "api",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"clean": "npx -y rimraf@latest ./container/pqc/dist",
		"start": "wrangler dev --live-reload --persist-to ../.wrangler/state",
		"build:types:cf": "wrangler types",
		"build:pqc": "tsc --project container/pqc/tsconfig.json",
		"build:static": "tsx staticApi.mts",
		"base": "node --disallow-code-generation-from-strings --enable-source-maps --experimental-websocket --tls-min-v1.3 --trace-warnings --use-largepages=silent",
		"start:pqc": "npm run base -- ./container/pqc/dist/index.mjs",
		"publish:static": "tsx apiGateway.mts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/autosec-network/eaas.git"
	},
	"author": "Autosec",
	"contributors": [
		"DemosJarco <1209494+demosjarco@users.noreply.github.com>"
	],
	"license": "AGPL-3.0-only",
	"private": true,
	"bugs": {
		"url": "https://github.com/autosec-network/eaas/issues"
	},
	"homepage": "https://github.com/autosec-network/eaas/tree/production/api#readme",
	"dependencies": {
		"@chainfuse/helpers": "^4.1.0",
		"@cloudflare/containers": "^0.0.28",
		"@hono/node-server": "^1.19.4",
		"@hono/zod-openapi": "^1.1.3",
		"@hono/zod-validator": "^0.7.3",
		"@mjackson/multipart-parser": "^0.10.1",
		"@noble/post-quantum": "^0.4.1",
		"cron-schedule": "^6.0.0",
		"cron-validate": "^1.4.5",
		"hono": "^4.9.8",
		"validator": "^13.15.15"
	},
	"devDependencies": {
		"@scalar/openapi-to-markdown": "^0.2.38",
		"@types/validator": "^13.15.3"
	}
}
