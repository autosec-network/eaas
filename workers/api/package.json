{
	"name": "api",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build:types:cf": "wrangler types",
		"postbuild:types:cf": "prettier --write worker-configuration.d.ts",
		"build:static": "tsx staticApi.mts",
		"build:db:tenant": "drizzle-kit generate --dialect=sqlite --driver durable-sqlite --casing=snake_case --schema=\"do/TenantD0/db/index.ts\" --out=\"do/TenantD0/db\"",
		"postbuild:db:tenant": "prettier --write do/TenantD0/db",
		"lint": "eslint **/*.*ts*",
		"lint:fix": "npm run lint -- --fix",
		"start": "wrangler dev --live-reload --persist-to ../.wrangler/state",
		"publish:static": "tsx apiGateway.mts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/autosec-network/eaas.git"
	},
	"author": "Autosec",
	"contributors": [
		"DemosJarco <1209494+demosjarco@users.noreply.github.com>"
	],
	"license": "AGPL-3.0-only",
	"private": true,
	"bugs": {
		"url": "https://github.com/autosec-network/eaas/issues"
	},
	"homepage": "https://github.com/autosec-network/eaas/blob/production/workers/api/README.md",
	"dependencies": {
		"@hono/zod-openapi": "^1.2.2",
		"@hono/zod-validator": "^0.7.6",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.3",
		"jose": "^6.1.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@scalar/openapi-to-markdown": "^0.3.53",
		"cloudflare": "^5.2.0"
	}
}
