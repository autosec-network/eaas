{
	"name": "api",
	"type": "module",
	"version": "0.0.0",
	"scripts": {
		"build:types:tsc": "tsc --incremental --noEmit",
		"build:types:cf": "wrangler types",
		"postbuild:types:cf": "prettier --write worker-configuration.d.ts",
		"build:static": "tsx staticApi.ts",
		"lint": "eslint **/*.*ts*",
		"lint:fix": "npm run lint -- --fix",
		"start": "wrangler dev --env prod --persist-to ../.wrangler/state",
		"publish:static": "tsx apiGateway.ts"
	},
