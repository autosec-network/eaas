{"openapi":"3.0.0","info":{"title":"EaaS API","description":"***Undergoing rearchitect/rewrite***\n\nInspired by Hashicorp Vault Transit, powered by Bitwarden Secrets Manager, node:crypto, and Web Crypto and runs fully on Cloudflare Workers. No data stored - just key management with pass-through encrypt/decrypt, and optional per-request wrapping for MITM/TLS inspection compliance.","contact":{"name":"Issues","url":"https://github.com/autosec-network/eaas/issues"},"version":"0.0.0"},"servers":[{"url":"/v0"}],"security":[{"ApiToken":[]}],"components":{"securitySchemes":{"ApiToken":{"type":"http","scheme":"bearer"}},"schemas":{},"parameters":{}},"paths":{"/apikeys/{token_id}":{"delete":{"tags":["API Key Management"],"description":"Delete a specific API Key by its token ID. Requires Admin permissions.","parameters":[{"schema":{"type":"string","minLength":22,"maxLength":22},"required":true,"name":"token_id","in":"path"}],"responses":{"200":{"description":"API Key successfully deleted.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"message":{"type":"string"}},"required":["success","message"]}}}},"403":{"description":"Access denied.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"errors":{"type":"array","items":{"type":"object","properties":{"message":{"type":"string"}},"required":["message"]}}},"required":["success","errors"]}}}},"404":{"description":"API Key not found.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"errors":{"type":"array","items":{"type":"object","properties":{"message":{"type":"string"}},"required":["message"]}}},"required":["success","errors"]}}}},"500":{"description":"Internal server error.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"errors":{"type":"array","items":{"type":"object","properties":{"message":{"type":"string"}},"required