{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"incremental": true,
		"lib": ["ESNext", "DOM", "WebWorker", "DOM.Iterable"],
		"jsx": "react-jsx",
		"jsxImportSource": "@builder.io/qwik",
		"noUncheckedSideEffectImports": false,
		"rootDir": "..",
		"outDir": "tmp",
		"paths": {
			"~/*": ["./src/*"],
			"~do/*": ["./do/*"]
		},
		"types": ["./worker-configuration.d.ts", "node", "turnstile-types"]
	},
	"files": ["./prettier.config.mjs", "eslint.config.mjs"],
	"include": ["../do-proxy/src", "adapters", "do", "project.inlang", "src", "./*.d.ts", "./*.config.ts"]
}
