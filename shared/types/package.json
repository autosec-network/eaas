{
	"name": "types",
	"type": "module",
	"main": "index.mts",
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./bw": {
			"import": "./dist/bw/index.mjs",
			"types": "./dist/bw/index.d.mts"
		},
		"./bw/schemas": {
			"import": "./dist/bw/schemas.js",
			"types": "./dist/bw/schemas.d.ts"
		},
		"./crypto": {
			"import": "./dist/crypto/index.js",
			"types": "./dist/crypto/index.d.ts",
			"default": "./dist/crypto/index.js"
		},
		"./crypto/catalog": {
			"import": "./dist/crypto/workers-crypto-catalog.js",
			"types": "./dist/crypto/workers-crypto-catalog.d.ts",
			"default": "./dist/crypto/workers-crypto-catalog.js"
		},
		"./tenants": {
			"import": "./dist/tenants/index.js",
			"types": "./dist/tenants/index.d.ts"
		},
		"./tenants/logging": {
			"import": "./dist/tenants/logging.js",
			"types": "./dist/tenants/logging.d.ts"
		},
		"./zod/mini": {
			"import": "./dist/zod-mini/index.js",
			"types": "./dist/zod-mini/index.d.ts"
		}
	},
	"scripts": {
		"build": "npm run build:types",
		"build:types": "tsc"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/autosec-network/eaas.git"
	},
	"author": "Autosec",
	"contributors": [
		"DemosJarco <1209494+demosjarco@users.noreply.github.com>"
	],
	"license": "AGPL-3.0-only",
	"private": true,
	"bugs": {
		"url": "https://github.com/autosec-network/eaas/issues"
	},
	"homepage": "https://github.com/autosec-network/eaas/blob/production/shared/types/README.md",
	"devDependencies": {
		"zod": "4.4.3"
	}
}
